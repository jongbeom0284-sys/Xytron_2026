#!/usr/bin/env python3
# -*- coding: utf-8 -*-

"""
ROS2 원본/압축 이미지 기반 흰색 차선 주행 Node
- BEV(탑뷰) 변환 및 모폴로지(노이즈 제거) 제거
- HSV 색공간 기반 흰색(White) 마스킹만 사용
- 히스토그램 피크(Peak)를 이용한 동적 슬라이딩 윈도우 
- [수정] 원본 이미지의 절반(하단부)을 아예 잘라내어 연산량 감소 (ROI Crop)
"""

import time
import cv2
import numpy as np
import rclpy
from rclpy.node import Node
from rclpy.qos import qos_profile_sensor_data
from sensor_msgs.msg import CompressedImage, Image
from std_msgs.msg import Float32MultiArray
from cv_bridge import CvBridge

def nothing(x):
    pass

def find_two_peaks(hist, min_distance=100, min_height=10):
    sorted_indices = np.argsort(hist)[::-1]
    peak1 = None
    peak2 = None
    for idx in sorted_indices:
        if hist[idx] < min_height:
            break
        if peak1 is None:
            peak1 = idx
        elif peak2 is None:
            if abs(idx - peak1) >= min_distance:
                peak2 = idx
                break
    
    if peak1 is not None and peak2 is not None:
        return min(peak1, peak2), max(peak1, peak2)
    elif peak1 is not None:
        return peak1, None
    return None, None

class Config:
    DEBUG_MODE = True
    IMAGE_WIDTH = 640
    IMAGE_HEIGHT = 480
    
    # 윈도우 파라미터
    NWINDOWS = 6
    MARGIN = 40
    MINPIX = 10
    
    # 원본 이미지에서 상단 몇 퍼센트를 버릴지 (0.5 = 상단 50% 버림)
    ROI_TOP_RATIO = 0.5 
    # 잘라낸 이미지 기준, 하단에서 몇 퍼센트 위를 목표점으로 삼을지
    LOOKAHEAD_RATIO = 0.6  
    
    Kp = 0.2
    Ki = 0
    Kd = 0.005
    EMA_ALPHA = 0.3 
    
    BASE_SPEED = 30.0
    MIN_SPEED = 15.0
    SPEED_DECAY = 0.6

class TrackDriveNode(Node):
    def __init__(self):
        super().__init__("track_drive_node")
        self.bridge = CvBridge()
        
        self.camera_sub = self.create_subscription(CompressedImage, "/image_raw/compressed", self.image_callback, qos_profile_sensor_data)
        self.motor_pub = self.create_publisher(Float32MultiArray, "/xycar_motor", 10)
        
        self.declare_parameter('h_low', 0)
        self.declare_parameter('h_high', 180)
        self.declare_parameter('s_low', 0)
        self.declare_parameter('s_high', 30)
        self.declare_parameter('v_low', 200)
        self.declare_parameter('v_high', 255)

        if Config.DEBUG_MODE:
            self.debug_pub = self.create_publisher(Image, "/debug/lane_image", 10)
            
            cv2.namedWindow("Trackbars", cv2.WINDOW_NORMAL)
            cv2.resizeWindow("Trackbars", 400, 300)
            cv2.createTrackbar("H_MIN", "Trackbars", 0, 180, nothing)
            cv2.createTrackbar("H_MAX", "Trackbars", 180, 180, nothing)
            cv2.createTrackbar("S_MIN", "Trackbars", 0, 255, nothing)
            cv2.createTrackbar("S_MAX", "Trackbars", 30, 255, nothing)
            cv2.createTrackbar("V_MIN", "Trackbars", 200, 255, nothing)
            cv2.createTrackbar("V_MAX", "Trackbars", 255, 255, nothing)

        self.prev_error = 0.0
        self.integral_error = 0.0
        self.last_time = time.time()
        self.prev_ema_angle = 0.0
        
        # [추가] 차선 소실 대비 기억 변수
        self.prev_target_x = None
        self.blind_count = 0
        
        # [추가] 20Hz 모터 퍼블리시 타이머 변수
        self.current_speed = 0.0
        self.current_angle = 0.0
        self.timer = self.create_timer(0.05, self.timer_callback)
        
        self.get_logger().info("Lane Follow Node Started (Cropped Raw Image, HSV Mode, 20Hz Timer)!")

    def timer_callback(self):
        # 카메라 처리 속도와 무관하게 20Hz로 지속적으로 모터 명령을 내려 VESC watchdog 멈춤 방지
        motor_msg = Float32MultiArray()
        motor_msg.data = [float(self.current_angle), float(self.current_speed)]
        self.motor_pub.publish(motor_msg)

    def image_callback(self, msg: CompressedImage):
        try:
            cv_img = self.bridge.compressed_imgmsg_to_cv2(msg, desired_encoding="bgr8")
        except Exception as e:
            self.get_logger().error(f"Image decode error: {e}")
            return
            
        current_time = time.time()
        cv_img = cv2.resize(cv_img, (Config.IMAGE_WIDTH, Config.IMAGE_HEIGHT))
        
        # [수정] 원본 이미지의 상단을 아예 잘라내어(Crop) 하단 절반만 메모리에 남김
        roi_top = int(Config.IMAGE_HEIGHT * Config.ROI_TOP_RATIO)
        cv_img = cv_img[roi_top:, :]
        
        cropped_height = cv_img.shape[0]  # 잘라낸 후의 세로 높이 (예: 240)
        
        if Config.DEBUG_MODE:
            h_l = cv2.getTrackbarPos("H_MIN", "Trackbars")
            h_h = cv2.getTrackbarPos("H_MAX", "Trackbars")
            s_l = cv2.getTrackbarPos("S_MIN", "Trackbars")
            s_h = cv2.getTrackbarPos("S_MAX", "Trackbars")
            v_l = cv2.getTrackbarPos("V_MIN", "Trackbars")
            v_h = cv2.getTrackbarPos("V_MAX", "Trackbars")
        else:
            h_l = self.get_parameter('h_low').value
            h_h = self.get_parameter('h_high').value
            s_l = self.get_parameter('s_low').value
            s_h = self.get_parameter('s_high').value
            v_l = self.get_parameter('v_low').value
            v_h = self.get_parameter('v_high').value
            
        # 색상 변환과 마스킹이 크롭된 작은 이미지(640x240)에서 수행되므로 연산 속도 2배 향상!
        hsv_img = cv2.cvtColor(cv_img, cv2.COLOR_BGR2HSV)
        white_mask = cv2.inRange(hsv_img, np.array([h_l, s_l, v_l]), np.array([h_h, s_h, v_h]))

        # [추가] 모폴로지 연산: 국소 노이즈 제거(Open) 및 선 연속성 강조(Close)
        kernel = np.ones((5, 5), np.uint8)
        white_mask = cv2.morphologyEx(white_mask, cv2.MORPH_OPEN, kernel)  # 자잘한 점 버림
        white_mask = cv2.morphologyEx(white_mask, cv2.MORPH_CLOSE, kernel) # 끊어진 선 이어줌

        nonzero = white_mask.nonzero()
        nonzeroy = np.array(nonzero[0])
        nonzerox = np.array(nonzero[1])
        
        out_img = None
        if Config.DEBUG_MODE:
            out_img = cv_img.copy()

        histogram = np.sum(white_mask, axis=0)
        p1, p2 = find_two_peaks(histogram, min_distance=100, min_height=10 * 255) 
        
        leftx_current, rightx_current = None, None
        
        midpoint = Config.IMAGE_WIDTH // 2
        if p1 is not None and p2 is not None:
            leftx_current = p1
            rightx_current = p2
        elif p1 is not None:
            if p1 < midpoint:
                leftx_current = p1
            else:
                rightx_current = p1

        window_height = int(cropped_height // Config.NWINDOWS)
        left_lane_inds, right_lane_inds = [], []
        
        for window in range(Config.NWINDOWS):
            win_y_low = cropped_height - (window + 1) * window_height
            win_y_high = cropped_height - window * window_height
            
            if leftx_current is not None:
                win_xleft_low = max(0, leftx_current - Config.MARGIN)
                win_xleft_high = min(Config.IMAGE_WIDTH, leftx_current + Config.MARGIN)
                
                if Config.DEBUG_MODE:
                    cv2.rectangle(out_img, (win_xleft_low, win_y_low), (win_xleft_high, win_y_high), (0, 255, 0), 2)
                    
                good_left_inds = ((nonzeroy >= win_y_low) & (nonzeroy < win_y_high) & (nonzerox >= win_xleft_low) & (nonzerox < win_xleft_high)).nonzero()[0]
                left_lane_inds.append(good_left_inds)
                if len(good_left_inds) > Config.MINPIX:
                    leftx_current = int(np.mean(nonzerox[good_left_inds]))

            if rightx_current is not None:
                win_xright_low = max(0, rightx_current - Config.MARGIN)
                win_xright_high = min(Config.IMAGE_WIDTH, rightx_current + Config.MARGIN)
                
                if Config.DEBUG_MODE:
                    cv2.rectangle(out_img, (win_xright_low, win_y_low), (win_xright_high, win_y_high), (0, 0, 255), 2)
                    
                good_right_inds = ((nonzeroy >= win_y_low) & (nonzeroy < win_y_high) & (nonzerox >= win_xright_low) & (nonzerox < win_xright_high)).nonzero()[0]
                right_lane_inds.append(good_right_inds)
                if len(good_right_inds) > Config.MINPIX:
                    rightx_current = int(np.mean(nonzerox[good_right_inds]))
        
        left_lane_inds = np.concatenate(left_lane_inds) if left_lane_inds else []
        right_lane_inds = np.concatenate(right_lane_inds) if right_lane_inds else []

        valid_left = len(left_lane_inds) > Config.MINPIX * 2
        valid_right = len(right_lane_inds) > Config.MINPIX * 2
        
        leftx, lefty = nonzerox[left_lane_inds], nonzeroy[left_lane_inds] if valid_left else ([], [])
        rightx, righty = nonzerox[right_lane_inds], nonzeroy[right_lane_inds] if valid_right else ([], [])
            
        target_x = None
        status_txt = "LANE LOST"
        # 목표점 Y 좌표 계산 (크롭된 이미지 하단에서 LOOKAHEAD_RATIO 만큼 올라간 지점)
        lookahead_y = int(cropped_height * (1.0 - Config.LOOKAHEAD_RATIO))

        left_fit = np.polyfit(lefty, leftx, 2) if valid_left else None
        right_fit = np.polyfit(righty, rightx, 2) if valid_right else None
        
        if valid_left and valid_right:
            center_fit = (left_fit + right_fit) / 2.0
            target_x = int(center_fit[0]*lookahead_y**2 + center_fit[1]*lookahead_y + center_fit[2])
            status_txt = "DUAL TRACKING"
            self.prev_target_x = target_x
            self.blind_count = 0
            
        elif valid_left:
            l_target = left_fit[0]*lookahead_y**2 + left_fit[1]*lookahead_y + left_fit[2]
            target_x = int(l_target + 300) 
            status_txt = "LEFT ONLY"
            self.prev_target_x = target_x
            self.blind_count = 0
            
        elif valid_right:
            r_target = right_fit[0]*lookahead_y**2 + right_fit[1]*lookahead_y + right_fit[2]
            target_x = int(r_target - 300)
            status_txt = "RIGHT ONLY"
            self.prev_target_x = target_x
            self.blind_count = 0
            
        else:
            if self.prev_target_x is not None and self.blind_count < 15:
                target_x = self.prev_target_x
                self.blind_count += 1
                status_txt = f"GHOST MODE ({self.blind_count})"
            else:
                target_x = None
                status_txt = "LANE LOST"
            
        if target_x is not None:
            error = target_x - (Config.IMAGE_WIDTH // 2)
        else:
            error = self.prev_error

        dt = max(current_time - self.last_time, 0.001)
        
        self.integral_error += error * dt
        self.integral_error = max(-500.0, min(500.0, self.integral_error)) 
        derivative_error = (error - self.prev_error) / dt
        
        raw_angle = (Config.Kp * error) + (Config.Ki * self.integral_error) + (Config.Kd * derivative_error)
        filtered_angle = (Config.EMA_ALPHA * raw_angle) + ((1.0 - Config.EMA_ALPHA) * self.prev_ema_angle)
        
        self.prev_error = error
        self.prev_ema_angle = filtered_angle
        self.last_time = current_time
        
        angle_clamped = float(max(-100.0, min(100.0, filtered_angle)))
        
        speed = float(max(Config.MIN_SPEED, min(Config.BASE_SPEED, Config.BASE_SPEED - abs(angle_clamped) * Config.SPEED_DECAY)))
        
        if status_txt == "LANE LOST": 
            speed = 0.0 
            angle_clamped = 0.0
            
        self.current_angle = angle_clamped
        self.current_speed = speed

        self.get_logger().info(f"State: {status_txt}, TargetX: {target_x}, Steer: {angle_clamped:.1f}, Speed: {speed:.1f}", throttle_duration_sec=2.0)
        
        if Config.DEBUG_MODE and out_img is not None:
            ploty = np.linspace(0, cropped_height - 1, cropped_height)
            if valid_left:
                pts_left = np.array([np.transpose(np.vstack([left_fit[0]*ploty**2 + left_fit[1]*ploty + left_fit[2], ploty]))], np.int32)
                cv2.polylines(out_img, pts_left, False, (0, 255, 255), 3)
            if valid_right:
                pts_right = np.array([np.transpose(np.vstack([right_fit[0]*ploty**2 + right_fit[1]*ploty + right_fit[2], ploty]))], np.int32)
                cv2.polylines(out_img, pts_right, False, (0, 255, 255), 3)
                
            if target_x is not None:
                cv2.circle(out_img, (target_x, lookahead_y), 8, (255, 0, 255), -1)
                cv2.line(out_img, (Config.IMAGE_WIDTH // 2, lookahead_y), (target_x, lookahead_y), (255, 255, 255), 2)
            
            cv2.line(out_img, (Config.IMAGE_WIDTH // 2, 0), (Config.IMAGE_WIDTH // 2, cropped_height), (100, 100, 100), 1)
            
            cv2.putText(out_img, f"State: {status_txt}", (10, 30), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 255), 2)
            cv2.putText(out_img, f"Angle: {angle_clamped:.1f}", (10, 60), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
            cv2.putText(out_img, f"Speed: {speed:.1f}", (10, 85), cv2.FONT_HERSHEY_SIMPLEX, 0.6, (255, 255, 255), 2)
            
            self.debug_pub.publish(self.bridge.cv2_to_imgmsg(out_img, encoding="bgr8"))
            
            cv2.imshow("White_Mask (HSV_Cropped)", white_mask)
            cv2.imshow("Lane_Control (Cropped)", out_img)
            cv2.waitKey(1)

def main(args=None):
    rclpy.init(args=args)
    node = TrackDriveNode()
    try: 
        rclpy.spin(node)
    except KeyboardInterrupt: 
        pass
    finally:
        if rclpy.ok():
            try:
                stop_msg = Float32MultiArray()
                stop_msg.data = [0.0, 0.0]
                node.motor_pub.publish(stop_msg) 
            except Exception:
                pass
        
        node.destroy_node()
        if rclpy.ok(): 
            rclpy.shutdown()
            
        try:
            cv2.destroyAllWindows()
        except:
            pass

if __name__ == "__main__":
    main()
