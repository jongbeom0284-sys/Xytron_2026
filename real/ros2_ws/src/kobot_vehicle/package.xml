<?xml version="1.0"?>
<package format="3">
  <name>kobot_vehicle</name>
  <version>0.1.0</version>
  <description>Jetson Orin NX vehicle devices, dashboard, and explicitly armed test controls.</description>
  <maintainer email="xytron@kobot.local">xytron</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>ackermann_msgs</exec_depend>
  <exec_depend>usb_cam</exec_depend>
  <exec_depend>web_video_server</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>
  <exec_depend>xycar_lidar</exec_depend>
  <exec_depend>kobot_lane_drive</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_pytest</test_depend>
  <test_depend>python3-pytest</test_depend>
  <export><build_type>ament_python</build_type></export>
</package>
