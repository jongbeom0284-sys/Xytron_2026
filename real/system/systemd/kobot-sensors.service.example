[Unit]
Description=Kobot ROS2 sensor dashboard (no motor)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=xytron
Group=xytron
SupplementaryGroups=dialout video
Environment=HOME=/home/xytron
WorkingDirectory=/home/xytron/2026_Xytron/real/ros2_ws
ExecStart=/bin/bash -lc '. /home/xytron/2026_Xytron/real/system/env/kobot_env.sh.example && exec ros2 launch kobot_vehicle sensors.launch.py'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
