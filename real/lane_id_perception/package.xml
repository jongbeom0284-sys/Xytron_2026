  <version>0.1.0</version>
  <description>Motor-free scanline lane ID perception for physical ROS2 vehicles.</description>
  <maintainer email="jongha0315@gmail.com">jjong-haya</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>cv_bridge</exec_depend>
